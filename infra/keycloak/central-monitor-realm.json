{
  "realm": "central-monitor",
  "enabled": true,
  "displayName": "Central Monitor",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "central-monitor",
      "name": "Central Monitor Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["${CENTRAL_PUBLIC_URL}/*"],
      "webOrigins": ["${CENTRAL_PUBLIC_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${CENTRAL_PUBLIC_URL}/*"
      }
    }
  ]
}
