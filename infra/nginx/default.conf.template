map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;

    location /api/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /auth/ {
        proxy_pass http://keycloak:8080/auth/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /db-monitor/api/ {
        proxy_pass ${BENNER_MONITOR_UPSTREAM}/api/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 420s;
        proxy_send_timeout 420s;
        client_max_body_size 20m;
    }

    location /db-monitor/ {
        proxy_pass ${BENNER_MONITOR_UPSTREAM}/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 420s;
        proxy_set_header Accept-Encoding "";
        sub_filter_once off;
        sub_filter '/api/' '/db-monitor/api/';
    }

    location = /.well-known/assetlinks.json {
        alias /usr/share/nginx/wellknown/assetlinks.json;
        default_type application/json;
    }

    location /m/ {
        alias /usr/share/nginx/mobile/;
        try_files $uri /m/index.html;
        add_header Cache-Control "no-cache";
    }

    location = / { proxy_pass http://web:80/; }
    location /assets/ { proxy_pass http://web:80/assets/; }
    location / { proxy_pass http://web:80; }
}
