POSTGRES_ADMIN_PASSWORD=change-me-admin
# Endereço público usado por navegadores e agentes. Na Oracle, use o domínio HTTPS.
CENTRAL_PUBLIC_URL=http://localhost:8090
CENTRAL_BIND_ADDRESS=127.0.0.1
CENTRAL_HTTP_PORT=8090
# Endereço do monitor Benner legado exibido dentro da Central.
BENNER_MONITOR_UPSTREAM=http://host.docker.internal:8091
CENTRAL_DB_PASSWORD=change-me-central
# Pool compartilhado por processo; dimensione o máximo considerando API, worker e PostgreSQL.
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=12
DATABASE_POOL_TIMEOUT_SECONDS=5
ZABBIX_DB_PASSWORD=change-me-zabbix
KEYCLOAK_DB_PASSWORD=change-me-keycloak
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
CENTRAL_SECRET_KEY=change-me-with-at-least-32-random-characters
ZABBIX_API_TOKEN=
ZABBIX_API_URL=http://zabbix-web:8080/api_jsonrpc.php
ZABBIX_USERNAME=Admin
ZABBIX_PASSWORD=zabbix
GLPI_DB_PASSWORD=change-me-glpi
GLPI_API_URL=http://glpi/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_USERNAME=glpi
GLPI_PASSWORD=glpi
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@nexora.local
SMTP_TLS=true
LOG_LEVEL=INFO
OIDC_ISSUER=http://localhost:8090/auth/realms/central-monitor
OIDC_JWKS_URL=http://keycloak:8080/auth/realms/central-monitor/protocol/openid-connect/certs
DEV_AUTH_BYPASS=false
MONITOR_INTERVAL_SECONDS=10
ACTION_EXECUTION_ENABLED=false
BENNER_INGEST_TOKEN=replace-with-a-long-random-token

# Push mobile (Expo).
# Lista (separada por virgulas) dos projectId EAS aceitos, um por ambiente (dev/hml/prod).
EXPO_PROJECT_IDS=
# Opcional: token de acesso Expo quando "enhanced push security" estiver ligado.
EXPO_ACCESS_TOKEN=

# Assinatura (Ed25519) das revisoes de consulta do Business Monitor. Gere com:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
BUSINESS_SIGNING_KEY=

# Broker dos jobs do Business Worker (somente rede privada). Para operar sem broker, deixe RABBITMQ_URL vazio.
RABBITMQ_USER=nexora
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_URL=amqp://nexora:change-me-rabbitmq@rabbitmq:5672/%2F
RABBITMQ_QUEUE_TYPE=classic
