<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexora.BusinessWorker\Nexora.BusinessWorker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Codigo do agente testado sem referenciar o executavel do agente inteiro. -->
    <Compile Include="..\Nexora.Agent\BusinessSupport.cs" />
    <Compile Include="..\Nexora.Agent\AgentOptions.cs" />
    <Compile Include="..\Nexora.Agent\DiskLevels.cs" />
    <Compile Include="..\Nexora.Agent\AgentUpdate.cs" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="TestVectors.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
